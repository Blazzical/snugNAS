# snugNAS docker-compose template — rendered by internal/compose from a *config.Config.
# Services are NOT exposed on the host network; Caddy is the only ingress.

name: snugnas

services:
  caddy:
    image: caddy:2.8
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    depends_on:
      - immich-server
      - jellyfin
      - filebrowser

  # ── Immich (photos) ───────────────────────────────────────────────────────
  immich-server:
    image: ghcr.io/immich-app/immich-server:release
    restart: unless-stopped
    volumes:
      - "{{.StorageRoot}}/photos:/usr/src/app/upload"
      - /etc/localtime:/etc/localtime:ro
    environment:
      DB_HOSTNAME: immich-postgres
      DB_USERNAME: postgres
      DB_PASSWORD: {{.PostgresPassword}}
      DB_DATABASE_NAME: immich
      REDIS_HOSTNAME: immich-redis
    depends_on:
      - immich-redis
      - immich-postgres

  immich-machine-learning:
    image: ghcr.io/immich-app/immich-machine-learning:release
    restart: unless-stopped
    volumes:
      - immich_model_cache:/cache

  immich-redis:
    image: docker.io/redis:6.2-alpine
    restart: unless-stopped

  immich-postgres:
    image: ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0
    restart: unless-stopped
    environment:
      POSTGRES_PASSWORD: {{.PostgresPassword}}
      POSTGRES_USER: postgres
      POSTGRES_DB: immich
    volumes:
      - "{{.StorageRoot}}/immich-db:/var/lib/postgresql/data"

  # ── Jellyfin (video/audio) ────────────────────────────────────────────────
  jellyfin:
    image: jellyfin/jellyfin:latest
    restart: unless-stopped
    volumes:
      - "{{.StorageRoot}}/jellyfin/config:/config"
      - "{{.StorageRoot}}/jellyfin/cache:/cache"
      - "{{.StorageRoot}}/media:/media:ro"
    environment:
      JELLYFIN_PublishedServerUrl: https://{{.Hostname}}/jellyfin

  # ── FileBrowser (general files) ───────────────────────────────────────────
  filebrowser:
    image: filebrowser/filebrowser:latest
    restart: unless-stopped
    volumes:
      - "{{.StorageRoot}}/files:/srv"
      - "{{.StorageRoot}}/filebrowser/database.db:/database.db"
      - "{{.StorageRoot}}/filebrowser/settings.json:/.filebrowser.json"

volumes:
  caddy_data:
  caddy_config:
  immich_model_cache:
