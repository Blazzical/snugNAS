# snugNAS docker-compose template — rendered by internal/compose from a *config.Config.
# Services are NOT exposed on the host network; Caddy is the only ingress.

name: snugnas

services:
  caddy:
    image: caddy:2.8
    restart: unless-stopped
    ports:
      # Host 80/443 are reserved on Windows by HTTP.sys/IIS by default.
      # Map to high ports so smoke-test works without touching IIS.
      # The installer (v0.4) will offer to free 80/443 properly.
      - "8080:80"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    depends_on:
      - immich-server
      - jellyfin
      - filebrowser

  # ── Immich (photos) ───────────────────────────────────────────────────────
  immich-server:
    image: ghcr.io/immich-app/immich-server:release
    restart: unless-stopped
    ports:
      # Direct port mapping for v0.2 — Caddy subpath works for Immich's API
      # but not its web UI assets. Wizard will switch to subdomain routing.
      - "2283:2283"
    volumes:
      - "{{.PosixStorageRoot}}/photos:/usr/src/app/upload"
      - /etc/localtime:/etc/localtime:ro
    environment:
      DB_HOSTNAME: immich-postgres
      DB_USERNAME: postgres
      DB_PASSWORD: {{.PostgresPassword}}
      DB_DATABASE_NAME: immich
      REDIS_HOSTNAME: immich-redis
    depends_on:
      - immich-redis
      - immich-postgres

  immich-machine-learning:
    image: ghcr.io/immich-app/immich-machine-learning:release
    restart: unless-stopped
    volumes:
      - immich_model_cache:/cache

  immich-redis:
    image: docker.io/redis:6.2-alpine
    restart: unless-stopped

  immich-postgres:
    image: ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0
    restart: unless-stopped
    environment:
      POSTGRES_PASSWORD: {{.PostgresPassword}}
      POSTGRES_USER: postgres
      POSTGRES_DB: immich
    volumes:
      - "{{.PosixStorageRoot}}/immich-db:/var/lib/postgresql/data"

  # ── Jellyfin (video/audio) ────────────────────────────────────────────────
  jellyfin:
    image: jellyfin/jellyfin:latest
    restart: unless-stopped
    ports:
      # Direct port mapping for v0.2 — Caddy subpath routing for Jellyfin
      # needs its internal "Base URL" set, which is wizard work for v0.3.
      - "8096:8096"
    volumes:
      - "{{.PosixStorageRoot}}/jellyfin/config:/config"
      - "{{.PosixStorageRoot}}/jellyfin/cache:/cache"
      - "{{.PosixStorageRoot}}/media:/media:ro"
    environment:
      JELLYFIN_PublishedServerUrl: http://{{.Hostname}}:8096

  # ── FileBrowser (general files) ───────────────────────────────────────────
  filebrowser:
    image: filebrowser/filebrowser:latest
    restart: unless-stopped
    volumes:
      - "{{.PosixStorageRoot}}/files:/srv"
      - filebrowser_data:/config

volumes:
  caddy_data:
  caddy_config:
  immich_model_cache:
  filebrowser_data:
