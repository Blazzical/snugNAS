# snugNAS Caddyfile template — single ingress for the stack.
# Listens on :80 inside the container (mapped to host 8080 in compose) and
# accepts any host header. v0.4 will switch to hostname-based matching with
# internal-CA TLS once mDNS is in place.

:80 {
    # Dashboard (Go binary on the host — Docker Desktop's host.docker.internal)
    handle / {
        reverse_proxy host.docker.internal:{{.DashboardPort}}
    }
    handle /api/* {
        reverse_proxy host.docker.internal:{{.DashboardPort}}
    }
    handle /static/* {
        reverse_proxy host.docker.internal:{{.DashboardPort}}
    }

    # Immich
    handle /photos/* {
        uri strip_prefix /photos
        reverse_proxy immich-server:2283
    }

    # Jellyfin
    handle /jellyfin/* {
        reverse_proxy jellyfin:8096
    }

    # FileBrowser
    handle /files/* {
        uri strip_prefix /files
        reverse_proxy filebrowser:80
    }
}
